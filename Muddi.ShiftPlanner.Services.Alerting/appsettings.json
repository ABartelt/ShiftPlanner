{
  "Database": {
    "Name": "shift_planner",
    "User": "",
    "Password": "",
    "Host": "postgres",
    "Port": 5432,
    "IncludeErrorDetail": false
  },
  "MuddiShiftClient": {
    "BaseUrl": "https://schicht.muddimarkt.org"
  },
  "Notifications": {
    "TimeZone": "Europe/Berlin",
    "PollInterval": "00:01:00",
    "DayBeforeLead": "1.00:00:00",
    "ShortBeforeLead": "00:30:00",
    "MaxAttempts": 3,
    "PublicBaseUrl": ""
  },
  "Telegram": {
    "ApiToken": "",
    "BotUsername": "",
    "GroupId": 0,
    "StartDate": "",
    "SendTime": "19:00:00",
    "SendOnProgramStart": false
  },
  "Twilio": {
    "AccountSid": "",
    "AuthToken": "",
    "WhatsAppFrom": "",
    "Templates": {
      "DayBefore": "",
      "DayBeforeNoRelease": "",
      "ShortBefore": ""
    }
  },
  "Signal": {
    "BaseUrl": "",
    "Number": ""
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "Security": "StartTls",
    "User": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "Schichtplaner"
  },
  "Serilog": {
    "Enrich": [
      "FromLogContext"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "System": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3} {SourceContext}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Properties": {
      "Application": "Muddi.ShiftPlanner.Services.Alerting"
    }
  },
  "AllowedHosts": "*"
}
