{
  "OAuth": {
    "Audience": "shift-planner",
    "Authority": "${SHIFT_PLANNER_KEYCLOAK_URL}/realms/${SHIFT_PLANNER_KEYCLOAK_REALM}",
    "AllowRegistration": ${SHIFT_PLANNER_ALLOW_REGISTRATION}
  },
  "ShiftApi": {
    "BaseUrl": "${SHIFT_PLANNER_API_URL}"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Error",
      "Microsoft.AspNetCore": "Warning",
      "HubConnection": "Warning",
      "System": "None"
    }
  }
}
